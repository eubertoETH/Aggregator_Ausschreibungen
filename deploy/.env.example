# Copy to .env beside compose.yaml on the target host. Do not commit the real file.
IMAGE_TAG=replace-with-commit-sha
SERVICE_PORT=8080
# Leave local-only unless a reverse proxy is configured deliberately.
SERVICE_BIND=127.0.0.1
POSTGRES_DB=aggregator
POSTGRES_USER=aggregator
# Set a unique, long password only on the target host.
POSTGRES_PASSWORD=replace-on-target-host
DATABASE_URL=postgresql+psycopg://aggregator:replace-on-target-host@db:5432/aggregator
