# Copy to <repository>-host/.env on the target host. Do not commit the real file.
AGGREGATOR_IMAGE=ghcr.io/eubertoeth/aggregator_ausschreibungen:replace-with-commit-sha
SERVICE_PORT=8080
# Leave local-only unless a reverse proxy is configured deliberately.
SERVICE_BIND=127.0.0.1
POSTGRES_DB=aggregator
POSTGRES_USER=aggregator
# This file is created manually on the host and contains the password only.
POSTGRES_PASSWORD_HOST_FILE=/opt/docker/aggregator_ausschreibungen-host/secrets/postgres_password
